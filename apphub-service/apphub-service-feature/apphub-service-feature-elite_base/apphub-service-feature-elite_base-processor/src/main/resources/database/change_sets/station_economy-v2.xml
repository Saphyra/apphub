<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-table-station_economy_v2" author="saphyra">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="elite_base" tableName="station_economy_v2"/>
            </not>
        </preConditions>

        <createTable schemaName="elite_base" tableName="station_economy_v2">
            <column name="station_id" type="varchar(37)">
                <constraints nullable="false"/>
            </column>
            <column name="economy" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="proportion" type="numeric"/>
        </createTable>

        <addPrimaryKey schemaName="elite_base" tableName="station_economy_v2" columnNames="station_id,economy" constraintName="station_economy_v2-pk"/>

        <createIndex schemaName="elite_base" tableName="station_economy_v2" indexName="index-station_economy_v2-station_id">
            <column name="station_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-foreign-key-station_economy_v2-station_id" author="Saphyra" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists schemaName="elite_base" foreignKeyName="station_economy_v2-station_id-fk"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
                baseTableSchemaName="elite_base"
                baseTableName="station_economy_v2"
                baseColumnNames="station_id"
                constraintName="station_economy_v2-station_id-fk"
                referencedTableSchemaName="elite_base"
                referencedTableName="station_v2"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />
    </changeSet>
</databaseChangeLog>

