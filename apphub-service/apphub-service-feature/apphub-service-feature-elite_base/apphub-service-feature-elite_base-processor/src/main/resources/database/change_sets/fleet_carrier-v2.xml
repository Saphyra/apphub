<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-table-fleet_carrier_v2" author="Saphyra">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="elite_base" tableName="fleet_carrier_v2"/>
            </not>
        </preConditions>

        <createTable schemaName="elite_base" tableName="fleet_carrier_v2">
            <column name="id" type="varchar(37)">
                <constraints nullable="false"/>
            </column>
            <column name="carrier_id" type="varchar(255)">
                <constraints unique="true"/>
            </column>
            <column name="carrier_name" type="text"/>
            <column name="star_system_id" type="varchar(37)">
                <constraints nullable="false"/>
            </column>
            <column name="docking_access" type="varchar(255)"/>
            <column name="market_id" type="numeric">
                <constraints unique="true"/>
            </column>
        </createTable>

        <addPrimaryKey schemaName="elite_base" tableName="fleet_carrier_v2" columnNames="id" constraintName="fleet_carrier_v2-pk"/>

        <createIndex schemaName="elite_base" tableName="fleet_carrier_v2" indexName="index-fleet_carrier_v2-carrier_id">
            <column name="carrier_id"/>
        </createIndex>

        <createIndex schemaName="elite_base" tableName="fleet_carrier_v2" indexName="index-fleet_carrier_v2-market_id">
            <column name="market_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableSchemaName="elite_base"
                baseTableName="fleet_carrier_v2"
                baseColumnNames="star_system_id"
                constraintName="fk-fleet_carrier_v2-star_system_id"
                referencedTableSchemaName="elite_base"
                referencedTableName="star_system"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />
    </changeSet>
</databaseChangeLog>