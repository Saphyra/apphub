<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-table-minor_faction_state_v2" author="Saphyra">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="elite_base" tableName="minor_faction_state_v2"/>
            </not>
        </preConditions>

        <createTable schemaName="elite_base" tableName="minor_faction_state_v2">
            <column name="minor_faction_id" type="varchar(37)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="trend" type="numeric"/>
        </createTable>

        <addPrimaryKey schemaName="elite_base" tableName="minor_faction_state_v2" columnNames="minor_faction_id,status,state" constraintName="minor_faction_state_v2-pk"/>

        <createIndex schemaName="elite_base" tableName="minor_faction_state_v2" indexName="index-minor_faction_state_v2-minor_faction_id-status">
            <column name="minor_faction_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex schemaName="elite_base" tableName="minor_faction_state_v2" indexName="index-minor_faction_state_v2-minor_faction_id">
            <column name="minor_faction_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableSchemaName="elite_base"
                baseTableName="minor_faction_state_v2"
                baseColumnNames="minor_faction_id"
                constraintName="fk-minor_faction_state_v2-minor_faction_id"
                referencedTableSchemaName="elite_base"
                referencedTableName="minor_faction"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />
    </changeSet>
</databaseChangeLog>