<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-table-body_v3" author="Saphyra" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="elite_base" tableName="body_v3"/>
            </not>
        </preConditions>

        <sql>
            CREATE TABLE elite_base.body_v3 (
            id varchar(37) NOT NULL,
            star_system_id varchar(37),
            type varchar(255),
            body_id numeric,
            body_name varchar(255),
            distance_from_star numeric,
            CONSTRAINT body_v3_pk PRIMARY KEY (id)
            ) PARTITION BY HASH (id);
        </sql>

        <sql>
            CREATE TABLE elite_base.body_v3_p0 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 0);
            CREATE TABLE elite_base.body_v3_p1 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 1);
            CREATE TABLE elite_base.body_v3_p2 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 2);
            CREATE TABLE elite_base.body_v3_p3 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 3);
            CREATE TABLE elite_base.body_v3_p4 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 4);
            CREATE TABLE elite_base.body_v3_p5 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 5);
            CREATE TABLE elite_base.body_v3_p6 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 6);
            CREATE TABLE elite_base.body_v3_p7 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 7);
            CREATE TABLE elite_base.body_v3_p8 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 8);
            CREATE TABLE elite_base.body_v3_p9 PARTITION OF elite_base.body_v3
            FOR VALUES WITH (MODULUS 10, REMAINDER 9);
        </sql>

        <addForeignKeyConstraint
                baseTableSchemaName="elite_base"
                baseTableName="body_v3"
                baseColumnNames="star_system_id"
                constraintName="fk-body_v3-star_system_id"
                referencedTableSchemaName="elite_base"
                referencedTableName="star_system"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />
    </changeSet>

    <changeSet id="create-table-body_v3" author="Saphyra" dbms="h2">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="elite_base" tableName="body_v3"/>
            </not>
        </preConditions>

        <createTable schemaName="elite_base" tableName="body_v3">
            <column name="id" type="varchar(37)">
                <constraints nullable="false"/>
            </column>
            <column name="star_system_id" type="varchar(37)"/>
            <column name="type" type="varchar(255)"/>
            <column name="body_id" type="numeric"/>
            <column name="body_name" type="varchar(255)"/>
            <column name="distance_from_star" type="numeric"/>
        </createTable>

        <addPrimaryKey schemaName="elite_base" tableName="body_v3" columnNames="id" constraintName="body_v3-pk"/>
        <addForeignKeyConstraint
                baseTableSchemaName="elite_base"
                baseTableName="body_v3"
                baseColumnNames="star_system_id"
                constraintName="fk-body_v3-star_system_id"
                referencedTableSchemaName="elite_base"
                referencedTableName="star_system"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />
    </changeSet>

    <changeSet id="create-index-body_v3-body_name" author="Saphyra">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="elite_base" tableName="body_v3" indexName="index-body_v3-body_name"/>
            </not>
        </preConditions>

        <createIndex schemaName="elite_base" tableName="body_v3" indexName="index-body_v3-body_name">
            <column name="body_name"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-index-body_v3-star_system_id" author="Saphyra">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists schemaName="elite_base" tableName="body_v3" indexName="index-body_v3-star_system_id"/>
            </not>
        </preConditions>

        <createIndex schemaName="elite_base" tableName="body_v3" indexName="index-body_v3-star_system_id">
            <column name="star_system_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>