<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-schema-monitoring" author="Saphyra">
        <sql endDelimiter=";">
            CREATE SCHEMA IF NOT EXISTS monitoring
        </sql>

        <rollback>
            DROP SCHEMA IF EXIST monitoring
        </rollback>
    </changeSet>

    <include file="database/change_sets/metric.xml"/>
    <include file="database/change_sets/metric_data.xml"/>
    <include file="database/change_sets/metric_property.xml"/>
    <include file="database/change_sets/metric_service.xml"/>
</databaseChangeLog>