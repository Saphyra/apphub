<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-table-metric_service" author="Saphyra">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="monitoring" tableName="metric_service"/>
            </not>
        </preConditions>

        <createTable schemaName="monitoring" tableName="metric_service">
            <column name="metric_id" type="varchar(37)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>