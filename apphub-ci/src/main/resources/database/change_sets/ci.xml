<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-schema-ci" author="Saphyra">
        <sql>CREATE SCHEMA IF NOT EXISTS ci</sql>

        <rollback>
            <sql>DROP SCHEMA IF EXISTS ci</sql>
        </rollback>
    </changeSet>

    <changeSet id="create-table-property" author="Saphyra">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="ci" tableName="property"/>
            </not>
        </preConditions>

        <createTable schemaName="ci" tableName="property">
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="text"/>
        </createTable>

        <addPrimaryKey schemaName="ci" tableName="property" columnNames="name"/>
    </changeSet>
</databaseChangeLog>